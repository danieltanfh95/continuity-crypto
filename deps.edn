{:paths ["src"]

 :deps
 {org.clojure/clojure    {:mvn/version "1.12.0"}

  ;; Biscuit capability tokens (offline authorisation). Bumping is a
  ;; coordinated change across every downstream consumer.
  org.biscuitsec/biscuit {:mvn/version "2.3.1"}}

 :aliases
 {;; Dev REPL
  :dev
  {:extra-paths ["test"]
   :extra-deps  {nrepl/nrepl       {:mvn/version "1.3.0"}
                 cider/cider-nrepl {:mvn/version "0.50.2"}}
   :main-opts   ["-m" "nrepl.cmdline"
                 "--middleware" "[cider.nrepl/cider-middleware]"
                 "--port" "0"
                 "--port-file" ".nrepl-port"]}

  ;; Test runner — kaocha
  :test
  {:extra-paths ["test"]
   :extra-deps  {lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                 org.clojure/test.check {:mvn/version "1.1.1"}}
   :main-opts   ["-m" "kaocha.runner"]}

  ;; Linter
  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
   :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test"]}

  ;; clj-kondo cache prep — populate analysis from dependencies
  :lint-init
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
   :main-opts    ["-m" "clj-kondo.main" "--copy-configs" "--dependencies"
                  "--lint" "src" "test"]}}}
